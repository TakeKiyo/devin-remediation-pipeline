# Copy to .env and fill in for a live run. Not needed when SIMULATE=true.

# --- credentials ---
DEVIN_API_KEY=            # service user key
DEVIN_ORG_ID=             # org- prefix
GITHUB_TOKEN=             # fine-grained PAT, fork only. Repository permissions:
                          #   Metadata: read
                          #   Issues: read and write   (labels live under Issues)
                          #   Pull requests: read

# --- target ---
REPO_FULL_NAME=<you>/superset
DEFAULT_BRANCH=<fork-default-branch>   # check the fork's actual default branch
TRIGGER_LABEL=devin-fix

# --- loop ---
POLL_INTERVAL_SEC=30                   # lower this (e.g. 10) while recording a demo
SESSION_TIMEOUT_MIN=45                 # exceeded -> terminate the session

# --- cost control ---
MAX_ACU_LIMIT=10                       # per session, enforced by the Devin API
MAX_CONCURRENT_SESSIONS=3

# --- mode ---
SIMULATE=false                         # true -> both integrations mocked
